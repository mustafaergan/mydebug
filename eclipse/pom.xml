<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.optona.mydebug</groupId>
    <artifactId>eclipse-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <modules>
        <module>com.optona.mydebug.eclipse</module>
        <module>com.optona.mydebug.eclipse.feature</module>
        <module>com.optona.mydebug.eclipse.site</module>
    </modules>

    <properties>
        <tycho.version>5.0.4</tycho.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <eclipse.release>https://download.eclipse.org/releases/2026-09</eclipse.release>
    </properties>

    <repositories>
        <repository>
            <id>eclipse-release</id>
            <url>${eclipse.release}</url>
            <layout>p2</layout>
        </repository>
    </repositories>

    <build>
        <plugins>
            <plugin>
                <groupId>org.eclipse.tycho</groupId>
                <artifactId>tycho-maven-plugin</artifactId>
                <version>${tycho.version}</version>
                <extensions>true</extensions>
            </plugin>
            <plugin>
                <groupId>org.eclipse.tycho</groupId>
                <artifactId>target-platform-configuration</artifactId>
                <version>${tycho.version}</version>
                <configuration>
                    <environments>
                        <environment><os>win32</os><ws>win32</ws><arch>x86_64</arch></environment>
                        <environment><os>linux</os><ws>gtk</ws><arch>x86_64</arch></environment>
                        <environment><os>macosx</os><ws>cocoa</ws><arch>aarch64</arch></environment>
                    </environments>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
